{
  "name": "@openlist-frontend/openlist-frontend",
  "version": "4.2.4",
  "type": "module",
  "author": {
    "name": "The OpenList Projects Contributors",
    "url": "https://github.com/OpenListTeam"
  },
  "description": "A new AList Fork to Anti Trust Crisis",
  "packageManager": "pnpm@11.10.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenListTeam/OpenList-Frontend.git"
  },
  "bugs": {
    "url": "https://github.com/OpenListTeam/OpenList/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://openlist.team/",
  "scripts": {
    "crowdin:upload": "crowdin upload sources --auto-update",
    "crowdin:download": "crowdin download --verbose",
    "crowdin": "pnpm crowdin:upload && pnpm crowdin:download",
    "i18n:build": "pnpm crowdin && node ./scripts/i18n.mjs",
    "i18n:release": "pnpm run crowdin:download && node ./scripts/i18n.mjs",
    "start": "vite",
    "dev": "vite --force",
    "build": "vite build",
    "build:lite": "cross-env VITE_LITE=true vite build",
    "serve": "vite preview",
    "prepare": "husky",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\""
  },
  "license": "MIT",
  "devDependencies": {
    "@crowdin/cli": "^4.14.3",
    "@types/crypto-js": "^4.2.2",
    "@types/mark.js": "^8.11.12",
    "@types/node": "^24.13.2",
    "@types/sha256": "^0.2.2",
    "@types/streamsaver": "^2.0.5",
    "@vitejs/plugin-legacy": "^8.2.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "3.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vite-plugin-dynamic-base": "^1.3.0",
    "vite-plugin-solid": "^2.11.12"
  },
  "dependencies": {
    "@hope-ui/solid": "github:OpenListTeam/hope-ui#31b436e36ae5d266016814ba71a442ffa9d91181",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/keyboard": "^1.3.7",
    "@solid-primitives/storage": "^1.3.11",
    "@solidjs/router": "^0.9.1",
    "@stitches/core": "^1.2.8",
    "@types/ini": "^4.1.1",
    "@viselect/vanilla": "^3.9.0",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.11.1",
    "ini": "^7.0.0",
    "mark.js": "^8.11.1",
    "mitt": "^3.0.1",
    "seemly": "^0.3.10",
    "sha256": "^0.2.0",
    "solid-contextmenu": "0.0.2",
    "solid-icons": "1.1.0",
    "solid-js": "^1.9.14",
    "solid-motionone": "^1.0.4",
    "solid-transition-group": "^0.3.0",
    "streamsaver": "^2.0.6",
    "typescript-natural-sort": "^0.7.2"
  },
  "lint-staged": {
    "**/*.{js,ts,css,tsx,jsx,md,html,yml,yaml}": "prettier --write"
  }
}
