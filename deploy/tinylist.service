[Unit]
Description=TinyList Private File Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tinylist
Group=tinylist
WorkingDirectory=/opt/tinylist
ExecStart=/opt/tinylist/tinylist server --data /opt/tinylist/data
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tinylist/data

[Install]
WantedBy=multi-user.target
