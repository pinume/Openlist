[Unit]
Description=OpenList Personal Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openlist
Group=openlist
WorkingDirectory=/opt/openlist
ExecStart=/opt/openlist/openlist server --data /opt/openlist/data
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openlist/data

[Install]
WantedBy=multi-user.target
